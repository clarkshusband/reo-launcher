# Maintainer: Polyfrost <contact@atmofrost.org>
pkgname=reo-launcher
pkgver=2.0.1
pkgrel=1
pkgdesc="Next-generation open source Minecraft launcher (built from source)"
arch=('x86_64')
url="https://github.com/drako1k/reo-launcher"
license=('GPL-3.0-only')
depends=(
  'fontconfig'
  'freetype2'
  'libglvnd'
  'libxcursor'
  'libxrandr'
  'libxi'
  'libxkbcommon'
  'wayland'
  'dbus'
  'gtk3'
  'libayatana-appindicator'
)
makedepends=(
  'rust'
  'cargo'
  'cmake'
  'clang'
  'pkgconf'
  'python'
)
provides=('reo-launcher')
conflicts=('reo-launcher-bin')
options=(
  '!lto'
  '!debug'
)
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/reo-launcher-${pkgver}.tar.gz")
sha256sums=('SKIP')

_srcdir="reo-launcher-reo-${pkgver}"

prepare() {
  cd "$srcdir/$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$_srcdir"
  export CARGO_HOME="$srcdir/cargo-home"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen --bin reo-launcher_app
}

package() {
  cd "$srcdir/$_srcdir"
  local appdir="packages/reo-launcher_app"

  install -Dm755 "target/release/reo-launcher_app" "$pkgdir/usr/bin/reo-launcher_app"
  ln -s reo-launcher_app "$pkgdir/usr/bin/reo-launcher"

  install -dm755 "$pkgdir/usr/share/applications"
  sed -e 's|{{exec}}|reo-launcher_app|g' \
      -e 's|{{icon}}|org.polyfrost.ReoLauncher|g' \
      "$appdir/distribution/linux/org.polyfrost.reo-launcher.template" \
      > "$pkgdir/usr/share/applications/org.polyfrost.ReoLauncher.desktop"

  install -Dm644 "$appdir/icons/32x32.png"    "$pkgdir/usr/share/icons/hicolor/32x32/apps/org.polyfrost.ReoLauncher.png"
  install -Dm644 "$appdir/icons/128x128.png"  "$pkgdir/usr/share/icons/hicolor/128x128/apps/org.polyfrost.ReoLauncher.png"
  install -Dm644 "$appdir/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/org.polyfrost.ReoLauncher.png"
  install -Dm644 "$appdir/icons/512x512.png"  "$pkgdir/usr/share/icons/hicolor/512x512/apps/org.polyfrost.ReoLauncher.png"
}
